# Copy this file to .env and fill in real values. Never commit .env.
# MongoDB Atlas connection string. Left unset/unreachable, the app runs in
# offline mode per LLD 6.3: guest Card Lookup works, shared features are disabled.
MONGODB_URI=mongodb+srv://<placeholder-user>:<placeholder-password>@<placeholder-cluster>.mongodb.net/?retryWrites=true&w=majority
